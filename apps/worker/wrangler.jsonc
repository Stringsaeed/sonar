// Local dev (Cloudflare Vite plugin) and worker tests only. Deploys go through sst.config.ts —
// keep bindings, DO migrations, and compatibility settings in sync with it.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sonar",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "Room", "class_name": "Room" },
      { "name": "Matchmaker", "class_name": "Matchmaker" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Matchmaker"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sonar",
      "migrations_dir": "migrations",
    },
  ],
}
